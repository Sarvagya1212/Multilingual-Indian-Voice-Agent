# Environment Variables for Multilingual Indian Voice Agent

# API Keys
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# STT Configuration
STT_PROVIDER=openai_whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu  # cpu, cuda

# TTS Configuration
TTS_PROVIDER=openai
TTS_VOICE=alloy  # alloy, echo, fable, nova, shimmer
TTS_MODEL=tts-1

# LLM Configuration
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514

# Vector Database
VECTOR_DB_PROVIDER=chromadb
CHROMADB_PATH=./chromadb_data

# Audio Configuration
SAMPLE_RATE=16000
CHANNELS=1
AUDIO_FORMAT=pcm16

# Application
LOG_LEVEL=INFO
SESSION_TIMEOUT_MINUTES=30
MAX_TOOL_CALL_RETRIES=3

# Optional: Dashboard
STREAMLIT_SERVER_PORT=8501